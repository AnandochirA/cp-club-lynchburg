# Postgres connection string (Neon, Supabase, Railway, local — anything Postgres).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Any long random string. Needed to read the signup list at /admin and to use
# the officer tools at /api/admin/*. Anyone with it can change ranks.
ADMIN_TOKEN="change-me-to-something-long-and-random"

# Testing only: point the LeetCode calls at a mock server. Leave unset in production.
# LEETCODE_GRAPHQL_URL="http://127.0.0.1:4010/graphql"

# Optional: the AI interviewer. With no key the site runs exactly as before
# (scripted coach, browser voice) and the AI option is hidden. The key is only
# read on the server. Each member gets 8 AI rounds a day; a round costs a few
# cents (the review shows an estimate).
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-6-luna"           # the interviewer's model
# OPENAI_TTS_MODEL="gpt-4o-mini-tts"  # its natural voice
